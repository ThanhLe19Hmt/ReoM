local function FormatNumber(n)
    n = tonumber(n) or 0
    if n < 1000 then return tostring(math.floor(n))
    elseif n < 1000000 then return string.format("%.1fK", n / 1000)
    elseif n < 1000000000 then return string.format("%.1fM", n / 1000000)
    else return string.format("%.1fB", n / 1000000000) end
end

